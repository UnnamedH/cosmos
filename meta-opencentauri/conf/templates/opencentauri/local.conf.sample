MACHINE ?= "centauri-carbon-1"
DISTRO = "cosmos"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

CONF_VERSION = "2"

# Optional. Puts the printer on a Tailscale tailnet. Leave this commented
# for a normal build: tailscaled is a Go process and the stock board has
# about 128 MB of RAM. Instructions are in Development.md.
# DISTRO_FEATURES:append = " tailscale"
